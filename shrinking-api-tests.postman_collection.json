        },
        {
          "name": "List slots, book last slot 11:45",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/patient/appointments/slots?doctorId={{doctorId}}&date={{shrinkReassignDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["patient", "appointments", "slots"],
              "query": [
                { "key": "doctorId", "value": "{{doctorId}}" },
                { "key": "date", "value": "{{shrinkReassignDate}}" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  pm.collectionVariables.set(k, v === undefined || v === null ? \"\" : String(v));",
                  "}",
                  "const slots = pm.response.json();",
                  "pm.test(\"8 slots\", () => pm.expect(slots.length).to.eql(8));",
                  "const last = slots.find(s => String(s.startTime).startsWith(\"11:45\"));",
                  "pm.test(\"11:45 exists\", () => pm.expect(last).to.exist);",
                  "setVar(\"lateSlotId\", last.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Book 11:45 STREAM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointment",
              "host": ["{{baseUrl}}"],
              "path": ["appointment"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"slotId\": \"{{lateSlotId}}\",\n  \"date\": \"{{shrinkReassignDate}}\",\n  \"startTime\": \"11:45\",\n  \"endTime\": \"12:00\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setVar(k, v) {",
                  "  pm.collectionVariables.set(k, v === undefined || v === null ? \"\" : String(v));",
                  "}",
                  "pm.test(\"2xx\", () => pm.expect([200, 201]).to.include(pm.response.code));",
                  "setVar(\"reassignApptId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Shrink to 10:00-11:30 (reassign)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{doctorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/doctor/availability/{{availabilityId}}/shrink",
              "host": ["{{baseUrl}}"],
              "path": ["doctor", "availability", "{{availabilityId}}", "shrink"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"{{shrinkReassignDate}}\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"11:30\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"window 10-11:30\", () => { pm.expect(j.availability.startTime).to.eql(\"10:00\"); pm.expect(j.availability.endTime).to.eql(\"11:30\"); });",
                  "const hit = (j.affectedAppointments || []).find(a => a.appointmentId === pm.collectionVariables.get(\"reassignApptId\"));",
                  "pm.test(\"reassigned\", () => { pm.expect(hit).to.exist; pm.expect(hit.resolution).to.eql(\"REASSIGNED\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
